# =============================================================================
# Backend — configuración de ejemplo
# =============================================================================
# Copiar a `backend/.env`. El backend VALIDA estas variables al arrancar
# (src/config/env.validation.ts) y NO arranca si faltan, si un secreto conserva
# el valor de ejemplo de este archivo o si el formato es inválido.
# Los valores de abajo son placeholders a propósito: reemplázalos todos.

# Entorno: development | test | production
NODE_ENV=development

# Server Port
PORT=3000

# -----------------------------------------------------------------------------
# Base de datos (OBLIGATORIAS)
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5455
DB_USER=root
DB_PASSWORD=your_database_password
DB_NAME=developDB
# El esquema lo crean las MIGRACIONES (`npm run migration:run`). `synchronize`
# queda APAGADO salvo que pongas true (solo prototipos/BD desechables). Con
# NODE_ENV=production + DB_SYNCHRONIZE=true el backend se niega a arrancar.
DB_SYNCHRONIZE=false

# -----------------------------------------------------------------------------
# Autenticación (better-auth)
# -----------------------------------------------------------------------------
# OBLIGATORIO: mínimo 32 caracteres. Genera uno con: openssl rand -base64 32
BETTER_AUTH_SECRET=your_better_auth_secret_min_32_chars
# URL propia del backend donde better-auth monta /api/auth (NO la del frontend).
# En producción debe ser https://
BETTER_AUTH_URL=http://localhost:3000

# Clave de cifrado de las URLs RTSP de las cámaras (AES-256-GCM).
# OBLIGATORIA: base64 de EXACTAMENTE 32 bytes. Genera una con: openssl rand -base64 32
# Si la cambias, las cámaras ya guardadas dejan de poder descifrarse.
CAMERAS_ENCRYPTION_KEY=change-me-generate-with-openssl-rand-base64-32

# -----------------------------------------------------------------------------
# Red
# -----------------------------------------------------------------------------
# URL del frontend (OBLIGATORIA): origin permitido por CORS y base de los links
# de los emails. En producción debe ser https://
FRONTEND_URL=http://localhost:5173
# Cantidad de reverse proxies/load balancers delante del backend (entero >= 0),
# para que el rate-limit y la auditoría vean la IP real del cliente y no la del
# proxy. Pon 1 si hay UN proxy. Debe ser EXACTAMENTE la cantidad real: un número
# mayor deja que el cliente falsifique su IP con X-Forwarded-For.
# "true" NO se acepta (confiaría en cualquier X-Forwarded-For, también el del
# cliente). Déjalo sin definir, vacío o en false si no hay proxy.
# TRUST_PROXY=1
# Interfaz en la que escucha el backend: IP (v4 o v6, sin corchetes) o nombre
# de host. Opcional; default 0.0.0.0 (todas las interfaces: el hub de la
# Raspberry y el LPR se conectan por la LAN). Con TRUST_PROXY activo, el puerto
# debe ser accesible SOLO desde el proxy (firewall) o usar HOST=127.0.0.1: si
# alguien llega directo al puerto, falsifica X-Forwarded-For y evade el límite
# de login por IP. El backend lo advierte al arrancar.
# HOST=0.0.0.0
# Swagger UI en /api (documentación de toda la API). En producción solo se
# monta con true; fuera de producción está activo salvo false.
# Opcional: true | false; default false en producción y true en el resto.
# SWAGGER_ENABLED=false

# -----------------------------------------------------------------------------
# Visitas
# -----------------------------------------------------------------------------
# Minutos que una solicitud del conserje digital (estado awaiting_approval)
# espera la respuesta del residente antes de expirar. Opcional: entero entre 1
# y 1440; si no se define, 30.
# VISIT_APPROVAL_TTL_MINUTES=30
# Minutos después del ingreso de una visita en los que el LPR NO registra su
# salida: las cámaras no saben si miran la entrada o la salida, y una lectura
# del auto que todavía está pasando se confundiría con una salida. La misma
# espera aplica tras la salida (el auto saliendo no se lee como reingreso).
# Opcional: entero entre 1 y 120; si no se define, 5.
# VISIT_EXIT_COOLDOWN_MINUTES=5
# Presupuesto de análisis de IA (Vision) del Guardián por condominio, en memoria
# del proceso. Pasado el límite la anomalía se guarda igual, sin análisis
# (aiStatus skipped). Ritmo sostenido (token bucket) por minuto: entero entre 1
# y 600; default 10.
# AI_VISION_RATE_PER_MINUTE=10
# Tope por día calendario UTC: entero entre 1 y 100000; default 300.
# AI_VISION_DAILY_CAP=300
# Segundos durante los que las lecturas de una misma patente (de cualquier
# cámara del condominio) se agrupan en UNA pasada: un solo intento de acceso y
# una sola apertura. Ventana deslizante. Opcional: entero entre 1 y 600; si no
# se define, 60.
# LPR_PASSAGE_WINDOW_SECONDS=60
# Segundos mínimos desde el inicio de una pasada para que una lectura con la
# dirección contraria (ambas por línea de cruce) abra una pasada nueva (el auto
# que entra y sale enseguida). Opcional: entero entre 1 y 600; default 15.
# LPR_PASSAGE_REVERSE_MIN_SECONDS=15
# Segundos tras los que una pasada sin intento (el líder falló o se colgó) cede
# el liderazgo a la siguiente lectura. Opcional: entero entre 1 y 600; default 30.
# LPR_PASSAGE_ORPHAN_SECONDS=30
# Segundos (desde la última lectura de la pasada) en que una lectura de una cámara
# de SOLO REGISTRO sin pasada exacta se agrupa con la pasada abierta de OTRA
# patente del mismo largo que difiere en un solo carácter (variante de OCR entre
# cámaras). Una cámara de acceso nunca se agrupa así: siempre decide por sí
# misma, por lo que el default de 30 no puede suprimir una decisión de acceso.
# 0 lo desactiva. Opcional: entero entre 0 y 600; default 30.
# LPR_PASSAGE_FUZZY_SECONDS=30
# Horas de validez de la visita que crea el conserje digital (desde la
# solicitud). Al aprobarla queda "en curso"; si el LPR no ve la salida, un
# regreso del mismo auto dentro de esta ventana se leería como salida y abriría.
# Opcional: entero entre 1 y 24; si no se define, 4.
# VISIT_CONCIERGE_VALIDITY_HOURS=4
# Horas después del fin de la validez de una visita en las que, si sigue "en
# curso" (el LPR no vio la salida), se cierra como expirada. Sin este cierre
# quedaría en curso para siempre y la retención nunca la anonimizaría.
# Opcional: entero entre 1 y 168; si no se define, 24.
# VISIT_ACTIVE_GRACE_HOURS=24

# -----------------------------------------------------------------------------
# Privacidad: retención y logs (Ley 21.719, docs/modulos/privacidad-ley-21719.md §3)
# -----------------------------------------------------------------------------
# Nivel mínimo del logger: error | warn | log | debug | verbose. Cada nivel
# incluye a los más graves. Default: log en producción (o sin NODE_ENV) y
# verbose en development/test. En producción usa debug/verbose solo para
# diagnosticar algo puntual: son los logs que más datos personales arrastran.
# Un valor fuera de la lista detiene el arranque.
# LOG_LEVEL=log
# "SMS" con el QR de la visita aprobada: hoy es un email a un sandbox de
# Mailtrap que lleva el teléfono del visitante y el QR (una credencial de
# acceso), no un SMS real. Apagado, no se envía nada ni se registra el
# teléfono. Opcional: true | false; si no se define, false.
# VISITOR_QR_SMS_ENABLED=false
# Barrido diario (3:30, hora de Chile) que borra o anonimiza los datos vencidos,
# por lotes y sin tocar nada vigente (visitas en curso, sesiones activas,
# detecciones esperando al conserje). Runbook: src/privacy/README.md.
# RETENTION_ENABLED controla SOLO las categorías de datos personales; con false
# la limpieza técnica (system_logs, sesiones/verificaciones vencidas de
# better-auth y rateLimit) sigue corriendo igual.
# Opcional: true | false; si no se define, true.
# RETENTION_ENABLED=true
# Modo de prueba: solo cuenta y registra lo que haría, sin escribir (en todas
# las categorías). Para probar a mano sin esperar a la madrugada:
#   node scripts/retention-run.js            (dry-run)
#   node scripts/retention-run.js --apply    (escribe)
# Opcional: true | false; si no se define, false.
# RETENTION_DRY_RUN=false
# Plazos en días (enteros, mínimo 1). Deben coincidir con la política de
# privacidad publicada. Entre paréntesis, el máximo aceptado.
# Imágenes: recorte y frame de patentes (también en Cloudinary) y foto de
# anomalías; la fila se conserva (365).
# RETENTION_IMAGES_DAYS=30
# Visitas y sesiones del conserje terminadas: se anonimizan, contados desde el
# cierre; también se borran los vehículos de visita que ya nadie usa (1825).
# RETENTION_VISITS_DAYS=90
# Detecciones e intentos de acceso: patente, residente y motivo se anonimizan;
# las métricas del dashboard siguen (1825).
# RETENTION_ACCESS_LOG_DAYS=90
# Anomalías (se borran) (1825).
# RETENTION_ANOMALIES_DAYS=90
# Notificaciones (se borran: copian los datos del visitante) (1825).
# RETENTION_NOTIFICATIONS_DAYS=90
# Acciones del agente (se borran todas: pasados 15 min ninguna se ejecuta) (1825).
# RETENTION_PENDING_ACTIONS_DAYS=90
# Auditoría (se borra) (3650).
# RETENTION_AUDIT_DAYS=365
# Logs del sistema, tabla system_logs (se borran; limpieza técnica, corre aunque
# RETENTION_ENABLED=false) (365).
# RETENTION_SYSTEM_LOGS_DAYS=30
# Usuarios deshabilitados: se anonimizan, contados desde la baja (1825).
# RETENTION_DISABLED_USERS_DAYS=30

# -----------------------------------------------------------------------------
# SMTP (emails de cuenta / reset de contraseña)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.your-email-provider.com
SMTP_PORT=587
SMTP_USER=your-email@domain.com
SMTP_PASS=your-email-password

# -----------------------------------------------------------------------------
# OpenAI / Agente-cerebro (docs/modulos/agente-cerebro.md)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-your-openai-api-key-here
# Origen de la API de OpenAI para las llamadas HTTP directas (token efímero de
# voz Realtime). Opcional; default https://api.openai.com. Sin usuario, query
# ni fragmento, y https en producción (cada request lleva OPENAI_API_KEY). Los
# e2e la apuntan a un servidor falso local. Los clientes del SDK (agente y
# visión) usan la variable estándar OPENAI_BASE_URL (con /v1).
# OPENAI_API_BASE_URL=https://api.openai.com
# Provider-agnóstico: hoy solo "openai" está implementado.
AGENT_MODEL_PROVIDER=openai
AGENT_MODEL_ID=gpt-4.1

# -----------------------------------------------------------------------------
# MediaMTX / cámaras
# -----------------------------------------------------------------------------
# Listener WebRTC/WHEP de MediaMTX. mediamtx/mediamtx.yml lo abre SOLO en
# loopback (127.0.0.1:8889): el navegador nunca habla con MediaMTX, el backend
# reenvía la oferta WHEP. Si MediaMTX corre en otra máquina, usa su IP interna
# (y ajusta webrtcAddress en el yml y MTX_AUTHHTTPADDRESS en MediaMTX).
MEDIAMTX_URL=http://127.0.0.1:8889
MEDIAMTX_CONTROL_URL=http://127.0.0.1:9997
CAMERAS_REGISTER_IN_MEDIAMTX=true
CAMERAS_STRICT_REGISTRATION=false
# Secreto compartido con MediaMTX (Fase 4 · P6.M). MediaMTX corre con
# authMethod: http y pregunta a POST /api/v1/internal/mediamtx/auth por cada
# lectura; el forward WHEP se autentica con Basic vigilia-backend:<este valor>.
# OBLIGATORIO si MEDIAMTX_URL está definida o CAMERAS_REGISTER_IN_MEDIAMTX=true;
# mínimo 32 caracteres y sin valores de ejemplo. Solo va en este .env (nunca en
# mediamtx.yml). Genera uno con: openssl rand -base64 32
# El mismo Basic autentica también las llamadas del backend a la Control API
# de MediaMTX (registro de cámaras y /v3/info).
MEDIAMTX_AUTH_SECRET=change-me-generate-with-openssl-rand-base64-32
# IPs desde las que se acepta POST /api/v1/internal/mediamtx/auth (la IP del
# socket, no X-Forwarded-For; con headers de proxy se rechaza). Default:
# 127.0.0.1,::1 (MediaMTX en el mismo host). Si MediaMTX corre en otra
# máquina, pon su IP interna. Lista separada por comas, sin máscaras.
# MEDIAMTX_AUTH_ALLOWED_IPS=127.0.0.1,::1
# Con CAMERAS_REGISTER_IN_MEDIAMTX=true el backend vuelve a registrar las
# cámaras activas al arrancar y cuando MediaMTX se reinicia (chequeo cada 30 s).
# Cliente de la Control API de MediaMTX (opcionales; valores por defecto):
# prefijo de la Control API (v3), que se agrega a MEDIAMTX_CONTROL_URL
# MEDIAMTX_CONTROL_API_BASE=/v3
# timeout de cada request, en ms
# MEDIAMTX_REQUEST_TIMEOUT_MS=5000
# intentos por operación (con backoff exponencial entre intentos)
# MEDIAMTX_MAX_ATTEMPTS=3
# espera base del backoff, en ms (se duplica en cada reintento)
# MEDIAMTX_BACKOFF_BASE_MS=500

# -----------------------------------------------------------------------------
# Worker LPR (manager)
# -----------------------------------------------------------------------------
WORKER_MANAGER_URL=http://localhost:8000
# Secreto compartido con lpr/ (el MISMO valor que WORKER_MANAGER_SECRET en
# lpr/.env). OBLIGATORIO si WORKER_MANAGER_URL está definida; mínimo 32
# caracteres y sin valores de ejemplo. Genera uno con: openssl rand -base64 32
WORKER_MANAGER_SECRET=change-me-generate-with-openssl-rand-base64-32
# Timeout de cada llamada del backend al manager LPR (registrar o dar de baja
# una cámara, health), en ms. Opcional; default 5000.
# WORKER_MANAGER_TIMEOUT=5000
# El LPR se autentica contra el backend con una API key de servicio con
# organización (header x-api-key). Se emite con POST /api/v1/auth/service-api-keys
# y se configura como LPR_SERVICE_API_KEY en lpr/.env. No hay nada que setear aquí.

# Hub (Raspberry Pi): cada hub tiene su PROPIO secret, generado por el backend al
# provisionarlo (POST /hubs, permiso "platform.manage-hubs") y configurado en
# vigilia-hub/.env (HUB_ID + HUB_SECRET). No hay nada que setear aquí.

# -----------------------------------------------------------------------------
# Cloudinary (subida de imágenes)
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
