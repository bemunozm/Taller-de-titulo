# Entorno (Fase 4 · P6.M). El hub valida el .env al arrancar (src/config.ts)
# y no arranca si algo no cumple. Sin NODE_ENV, o con un valor distinto de
# development/test, se aplican las reglas de PRODUCCIÓN:
#   - BACKEND_URL con https:// (el WebSocket usa wss:// derivado de ella);
#   - HUB_ID y HUB_SECRET obligatorios;
#   - DEBUG_OPENAI_KEY prohibida.
# Solo con NODE_ENV=development se acepta http:// (con un aviso en el log).
NODE_ENV=production

# Backend: SOLO el origen (esquema://host[:puerto]), sin /api/v1 ni barra
# final. Una sola variable: BACKEND_API_URL (nombre viejo) ya no hace falta;
# si se define, debe ser igual a BACKEND_URL.
BACKEND_URL=https://vigilia.example.cl

# Fase 1, Bloque A1.1 (docs/modulos/agente-cerebro.md §7/§11 — hallazgo H1):
# HUB_SECRET ya NO es un valor global compartido entre hubs. Es el secret
# PROPIO de ESTE hub, generado por el backend al provisionarlo
# (POST /hubs, requiere el permiso "platform.manage-hubs") — se muestra en
# texto plano UNA sola vez en la respuesta; cópialo acá y no lo pierdas (si
# se pierde, hay que rotarlo con POST /hubs/:hubId/rotate-secret, lo que
# invalida este valor). HUB_ID debe coincidir con el hubId usado al
# provisionar.
HUB_SECRET=<secret devuelto por POST /hubs al provisionar este hub>

# Hub Identification
HUB_ID=hub-001
# (La ubicación del hub ya no se configura acá: se define en el backend al
# provisionarlo con POST /api/v1/hubs, campo "location".)

# GPIO Pins (BCM numbering)
RELAY_PIN_1=17
RELAY_PIN_2=27
# Opcionales; defaults del código (descomenta solo para cambiarlos):
# RELAY_DOOR_PIN=22   # relé de puerta (DoorController)
# RELAY_GATE_PIN=23   # relé de portón (DoorController)
# HANGUP_GPIO=22      # detección de colgado (GpioController)

# Audio Configuration
# Dispositivos de audio (usar aplay -L y arecord -L para ver disponibles)
# Para Raspberry Pi 3:
#   - Jack 3.5mm: plughw:CARD=Headphones,DEV=0
#   - HDMI: plughw:CARD=vc4hdmi,DEV=0
#   - USB Audio: plughw:CARD=Device,DEV=0
AUDIO_DEVICE=plughw:CARD=Headphones,DEV=0
CAPTURE_DEVICE=plughw:CARD=Device,DEV=0
SAMPLE_RATE=24000
TARGET_SAMPLE_RATE=24000
# Opcional; default del código (descomenta solo para cambiarlo):
# AUDIO_CHANNELS=1

# Echo Suppression (half-duplex). Defaults del código.
# Umbral RMS en dB bajo el cual se considera silencio (más negativo = más sensible)
RMS_THRESHOLD_DB=-45
# Cola de supresión tras dejar de reproducir, en ms
SUPPRESSION_TAIL_MS=300
# Cualquier valor distinto de "false" lo deja activado
# HALF_DUPLEX_ENABLED=true

# Teclado / conversación (opcionales; defaults del código)
# KEYPAD_TIMEOUT_MS=5000
# COOLDOWN_MS=3000
# SCAN_INTERVAL_MS=30
# MAX_CONVERSATION_TIME_MS=180000

# Connectivity
CONNECTIVITY_CHECK_INTERVAL_MS=30000
CACHE_SYNC_INTERVAL_MS=300000

# Relay Safety
RELAY_SETTLING_TIME_MS=200
MAX_INTERCEPT_TIME_MS=180000

# Logging. En info no se registran transcripciones, argumentos de tools,
# contexto de la casa, prompt ni sessionId; debug agrega el detalle de los
# eventos con esos campos redactados (src/utils/log-redaction.ts). Los archivos
# van a logs/ (fuera de git).
LOG_LEVEL=info

# Solo desarrollo (prohibida en producción): API key directa de OpenAI que
# salta el token efímero del backend. Déjala vacía.
# DEBUG_OPENAI_KEY=
