# CodeGraph (indice local; codegraph.json se versiona)
.codegraph/

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
venv/

# LPR runtime data (no versionar detecciones/logs/modelos)
# OJO: NO ignorar `storage/` a secas — es un PAQUETE DE CÓDIGO
# (storage/fs_storage.py, storage/__init__.py). Ignorarlo haría que archivos
# nuevos del paquete se perdieran en silencio. Aquí solo se ignoran los
# directorios de datos/artefactos que produce el worker.
detecciones/
logs/
crops/
frames/
*.pt

# Env
.env
