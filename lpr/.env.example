# =============================================================================
# lpr — configuración de ejemplo (manager + workers)
# =============================================================================
# Copiar a `lpr/.env` y ajustar. Todas las variables son las que lee
# `settings.py` (clase Settings). Los valores mostrados son los DEFAULT del
# código; las líneas comentadas usan el default si se dejan sin definir.
#
# OBLIGATORIAS EN PRODUCCIÓN: WORKER_MANAGER_SECRET y LPR_SERVICE_API_KEY.
# =============================================================================

# -----------------------------------------------------------------------------
# Manager / backend
# -----------------------------------------------------------------------------
# URL base de la API del backend, CON el prefijo /api/v1 (reconciliación de
# cámaras vía GET /workers/cameras; se pasa al worker para la ingesta).
WORKER_BACKEND_URL=http://localhost:3000/api/v1
# [OBLIGATORIA EN PROD] Secreto compartido con el backend para notificar al manager.
# Debe ser el MISMO valor que WORKER_MANAGER_SECRET en backend/.env. Mínimo 32
# caracteres: genera uno con `openssl rand -base64 32`. Un valor de ejemplo
# (como el de abajo) o más corto impide arrancar el LPR. Vacío = sin secreto
# (el manager rechaza toda petición, salvo WORKER_MANAGER_ALLOW_NO_SECRET=true).
WORKER_MANAGER_SECRET=change-me-to-a-secure-random-value
# Escape hatch SOLO-DEV: arranca el manager sin secreto. En prod DEBE ser false (fail-closed).
WORKER_MANAGER_ALLOW_NO_SECRET=false
# Puerto donde escucha el manager.
WORKER_MANAGER_PORT=8000
# Host de bind del manager (0.0.0.0 = todas las interfaces).
WORKER_MANAGER_HOST=0.0.0.0
# Auto-reload de uvicorn (solo desarrollo).
WORKER_MANAGER_RELOAD=false
# Nº de workers de uvicorn para el manager.
WORKER_MANAGER_WORKERS=1
# Cada cuántos segundos el hilo supervisor revisa procesos caídos y los reinicia.
LPR_SUPERVISOR_INTERVAL=5.0
# Tope de reinicios por cámara dentro de la ventana antes de marcarla 'failed'.
LPR_SUPERVISOR_MAX_RESTARTS=5
# Ventana (s) en la que se cuentan los reinicios para el tope anterior.
LPR_SUPERVISOR_RESTART_WINDOW_SECONDS=300.0
# Backoff base (s) entre reintentos de reinicio (exponencial: base * 2^(n-1)).
LPR_SUPERVISOR_BACKOFF_BASE_SECONDS=2.0
# Tope del backoff exponencial anterior.
LPR_SUPERVISOR_BACKOFF_MAX_SECONDS=60.0
# Límite duro de procesos worker concurrentes que el manager acepta arrancar.
LPR_MAX_PROCS=8
# Hilos de procesamiento de frames DENTRO de cada proceso worker (ThreadPoolExecutor).
# No confundir con LPR_MAX_PROCS (nº de procesos, uno por cámara). Mínimo 1; en la
# Raspberry Pi déjalo en 1 (más hilos solo compiten por la CPU).
LPR_MAX_WORKERS=1

# -----------------------------------------------------------------------------
# LPR worker — conexión y modelos
# -----------------------------------------------------------------------------
# URL RTSP de la cámara (normalmente la inyecta el manager por cámara).
LPR_RTSP_URL=
# ID de la cámara (normalmente lo inyecta el manager).
LPR_CAMERA_ID=
# URL del backend a la que el worker envía eventos (si vacío, se deriva de WORKER_BACKEND_URL).
LPR_BACKEND_URL=
# Fotogramas por segundo que se muestrean del stream (la fuente por cámara,
# `lprSettings.sampleFps`, tiene prioridad). LPR_POLL_INTERVAL (segundos entre
# lecturas) está OBSOLETA pero se respeta si LPR_SAMPLE_FPS no está definida.
# Sin ninguna de las dos se usa el argumento del manager o 1 fps.
# LPR_SAMPLE_FPS=1.0
# Resolución de entrada del detector (YOLO imgsz). 640 = default de ultralytics;
# para el portón 1920x1080 se midió que hace falta 1920 (ver tools/replay_eval.py).
LPR_DETECTOR_IMGSZ=640
# Dispositivos (dependen del HOST, por eso son globales). Vacío = automático.
# LPR_DEVICE=cuda:0
LPR_OCR_DEVICE=cpu
# Filtro de forma del recorte de la patente. Una patente vista en ángulo sale
# casi cuadrada (ratio ~1.3): para esas cámaras usar min ratio 0.8 / max 6.
# LPR_CROP_MAX_W vacío = sin tope.
LPR_CROP_MIN_W=30
LPR_CROP_MAX_W=
LPR_CROP_MIN_H=10
LPR_CROP_MIN_AREA=300
LPR_CROP_MIN_RATIO=2.0
LPR_CROP_MAX_RATIO=12.0
# Seguimiento + voto: lecturas concordantes de UN mismo vehículo para emitir
# (con N=2 la evaluación dio una patente incorrecta: no bajar de 3) y segundos
# sin ver la patente tras los cuales se cierra el seguimiento.
LPR_CONFIRM_READS=3
LPR_TRACK_MAX_GAP_SECONDS=1.5
# Modo simulación: no envía eventos reales al backend.
LPR_DRY_RUN=false
# Modelo detector de patentes (repo/id en Hugging Face o ruta local).
LPR_DETECTOR_MODEL=morsetechlab/yolov11-license-plate-detection
# Modelo OCR de fast-plate-ocr.
LPR_OCR_MODEL=cct-s-v1-global-model
# [OBLIGATORIA EN PROD] API key de servicio: ÚNICA credencial del LPR contra el
# backend, enviada en el header `x-api-key` por el worker (ingesta: POST
# /detections/plates, /detections/plates/attempts, POST/GET /anomalies) y por el
# manager (GET /workers/cameras y /workers/cameras/:id/source).
# Generarla con un admin QUE PERTENEZCA AL CONDOMINIO vía
# `POST /api/v1/auth/service-api-keys` (permiso "auth.manage-service-tokens"):
# la key queda acotada a ese condominio; sin condominio, /workers/* da 403.
# La key en texto plano solo se muestra una vez en esa respuesta.
# (WORKER_BACKEND_TOKEN y LPR_WORKER_TOKEN se retiraron: bórralos de tu .env,
# o el arranque falla con "Extra inputs are not permitted".)
LPR_SERVICE_API_KEY=

# -----------------------------------------------------------------------------
# LPR worker — reconexión RTSP
# -----------------------------------------------------------------------------
# Timeout (ms) para abrir el stream RTSP.
LPR_STREAM_OPEN_TIMEOUT_MS=10000
# Timeout (ms) por lectura de frame (evita que cap.read() bloquee indefinidamente).
LPR_STREAM_READ_TIMEOUT_MS=8000
# Lecturas fallidas consecutivas antes de forzar una reconexión.
LPR_STREAM_MAX_READ_FAILURES=15
# Si no llega un frame nuevo en N segundos, forzar reconexión (stream congelado).
LPR_STREAM_STALE_SECONDS=20.0
# Intentos de reapertura por ciclo de reconexión antes de terminar el proceso.
LPR_STREAM_RECONNECT_MAX_ATTEMPTS=5
# Backoff base (s) entre intentos de reapertura (exponencial, tope 30s).
LPR_STREAM_RECONNECT_BACKOFF_SECONDS=2.0

# -----------------------------------------------------------------------------
# LPR worker — almacenamiento de detecciones
# -----------------------------------------------------------------------------
# Directorio raíz de detecciones (relativo se resuelve contra el repo/paquete).
LPR_DETECTIONS_DIR=./lpr/detecciones
# Directorio de crops (recortes de patente).
LPR_SAVE_CROPS_DIR=./lpr/detecciones/crops
# Directorio de frames completos.
LPR_SAVE_FRAMES_DIR=./lpr/detecciones/frames
# Guardar solo cuando se detecta patente (no frames vacíos).
LPR_SAVE_ONLY_ON_PLATE=true
# Adjuntar snapshot en el evento enviado al backend.
LPR_INCLUDE_SNAPSHOT=true

# -----------------------------------------------------------------------------
# LPR worker — umbrales de tuning (detección / OCR / confirmación)
# -----------------------------------------------------------------------------
# Confianza mínima del detector para considerar una caja.
LPR_MIN_DET_CONF=0.3
# Ventana de dedupe: ignora la misma patente repetida dentro de N segundos.
LPR_DEDUP_SECONDS=120.0
# Participación mínima del texto ganador (ponderada por confianza OCR) para emitir:
# un seguimiento con lecturas muy divididas no se emite aunque llegue a N.
LPR_MIN_WINNER_SHARE=0.6

# -----------------------------------------------------------------------------
# OBSOLETAS: sin efecto desde el seguimiento + voto. Siguen declaradas en Settings
# (que rechaza variables extra) solo para no romper el arranque de un .env
# existente; NO las configures:
#   LPR_DET_HIGH_CONF, LPR_OCR_HIGH_CONF, LPR_DET_CONF_THRESHOLD,
#   LPR_OCR_CONF_THRESHOLD, LPR_MIN_CHAR_CONF, LPR_MIN_CHAR_CONF_RATIO,
#   LPR_MIN_EVENT_INTERVAL, LPR_FORCE_SAVE_ON_OCR, LPR_CONFIRM_FRAMES,
#   LPR_CONFIRM_SECONDS, LPR_SIGHTING_TTL_SECONDS, LPR_COMBINED_ALPHA,
#   LPR_COMBINED_THRESHOLD, LPR_POLL_INTERVAL (usar LPR_SAMPLE_FPS).
# -----------------------------------------------------------------------------

# Formato de patente: por defecto rige el formato chileno (LLLL## con las 18
# letras BCDFGHJKLPRSTVWXYZ, y LL####) con corrección posicional de confusiones
# (0/O/D, 1/I/L, 2/Z, 5/S, 8/B...), ver processor/plate_format.py. Dejar este
# valor VACÍO. Si se define, anula ese formato y la corrección: el texto debe
# calzar tal cual con el regex (sirve para otro país). Ejemplo:
# LPR_PLATE_REGEX=^[A-Z]{2}[0-9]{3}[A-Z]{2}$

# -----------------------------------------------------------------------------
# Guardián — refetch de zonas/config
# -----------------------------------------------------------------------------
# Segundos entre refetch de zonas de intrusión y del toggle enableGuardian.
LPR_ZONES_REFETCH_SECONDS=60.0
# El worker LPR reutiliza esta misma cadencia para refrescar en caliente la
# configuración por cámara (GET /workers/cameras/:id/lpr-settings: zona, imgsz,
# fps, lecturas de confirmación...). No hace falta una variable aparte.

# -----------------------------------------------------------------------------
# Retención de disco (purga de detecciones/crops/frames viejos)
# -----------------------------------------------------------------------------
# Días de antigüedad tras los cuales se purgan archivos (0 = desactivado).
LPR_RETENTION_DAYS=7
# Tamaño total máximo (MB) por directorio; si se excede, purga los más viejos (0 = desactivado).
LPR_RETENTION_MAX_MB=2000
# Cada cuántos segundos corre el hilo de retención del manager.
LPR_RETENTION_CHECK_INTERVAL_SECONDS=3600.0

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
# Nivel de log (DEBUG / INFO / WARNING / ERROR).
LOG_LEVEL=INFO
# Tamaño máximo (bytes) por archivo de log antes de rotar.
LPR_LOG_MAX_BYTES=10000000
# Cantidad de archivos rotados a conservar por cámara/componente.
LPR_LOG_BACKUP_COUNT=3

# -----------------------------------------------------------------------------
# Cloudinary (subida opcional de imágenes de detección)
# -----------------------------------------------------------------------------
# Habilita la subida a Cloudinary (si false, se guarda solo local).
CLOUDINARY_UPLOAD=false
# Credenciales Cloudinary (requeridas solo si CLOUDINARY_UPLOAD=true).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Borrar la copia local tras subir con éxito a Cloudinary.
CLOUDINARY_DELETE_LOCAL=false
# Reintentos de subida ante fallo de red.
CLOUDINARY_UPLOAD_RETRIES=3
# Backoff (s) base entre reintentos de subida.
CLOUDINARY_RETRY_BACKOFF=1.0
