# Variables de entorno con secretos, en cualquier carpeta (Fase 4 · P9). Solo
# se versionan las plantillas `.env.example`.
.env
.env.*
!.env.example

# Config real del relay de cámaras (edge/camera-relay): trae la clave del NVR.
# Solo se versionan relay.env.example y cameras.conf.example.
relay.env
cameras.conf

# Videos grandes de pruebas
mediamtx/*.mp4
lpr/test_video/*.mp4

# CodeGraph — indices locales por maquina.
# NOTA: los codegraph.json (config) y codegraph.workspace.json SI se versionan.
.codegraph/
**/.codegraph/

# Herramientas de agentes / editor (local, no versionar)
.agent/
.agents/
.claude/
.vscode/
skills-lock.json
repomix-output.xml

# Backups / carpetas temporales duplicadas
vigilia-hub-temp/

# Modelos YOLO (pesos grandes, no versionar en git)
*.pt

# Dependencias / cachés de Node en la raíz (p.ej. vitest corrido desde aquí)
node_modules/

# Python
__pycache__/
*.pyc
*.pyo

# OS
.DS_Store
Thumbs.db

# Datos personales de evaluacion del LPR (clips y verdad terreno: patentes y personas, Ley 21.719)
lpr/eval-data/
# Cualquier video bajo lpr/ (clips grabados de camaras: personas y patentes) y las salidas de replay_eval
lpr/**/*.mkv
lpr/**/*.avi
lpr/**/*.mp4
lpr/**/*.mov
lpr/**/replay-*.json
